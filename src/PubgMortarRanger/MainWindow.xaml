<Window x:Class="PubgMortarRanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mortar Rangefinder" Width="440" Height="170"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#C9D3DA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#33434F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Border CornerRadius="12" Padding="18" BorderBrush="#77B9E46E" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F20B131B" Offset="0"/>
                <GradientStop Color="#EE101D28" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#B9E46E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="MORTAR RANGEFINDER" Foreground="#E5F0F4" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Content="×" Click="OnCloseClick" DockPanel.Dock="Right" Padding="8,2" ToolTip="关闭"/>
                <Button Content="—" Click="OnMinimizeClick" DockPanel.Dock="Right" Padding="8,2" ToolTip="最小化"/>
                <Button Content="设置" Click="OnSettingsClick" DockPanel.Dock="Right" Padding="8,2"/>
            </DockPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DistanceText" Text="--- m" Foreground="#F5FBFF" FontSize="42" FontWeight="Bold" Margin="0,8,28,8"/>
                <StackPanel Margin="0,8">
                    <TextBlock x:Name="BearingText" Text="---°" Foreground="#E3EEF5" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RangeText" Text="未标定" Foreground="#B9E46E" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Row="2" Background="#332B3B46" CornerRadius="5" Padding="8,4" Margin="0,3,0,0">
                <TextBlock x:Name="HintText" Text="F8 两次点击标定/测距 | F10 清除" Foreground="#C8D1D8" FontSize="12"/>
            </Border>
        </Grid>
    </Border>
</Window>
